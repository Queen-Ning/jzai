{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "**/*.sql",
      "**/*.ttf",
      "platform/sandbox/runner/vendor/**/*",
      "platform/sandbox/wit/*.wit",
      "platform/sandbox/__fixtures__/pure.wasm"
    ],
    "watchAssets": true
  }
}
